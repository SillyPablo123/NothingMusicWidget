<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container_layer2"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_squircle_dark">

    <ImageView
        android:id="@+id/iv_cover_art"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="Album Art"
        android:scaleType="fitXY" />

    <!-- Animador fluido de 6 fotogramas para ecualizador dot-matrix (ViewFlipper nativo) -->
    <ViewFlipper
        android:id="@+id/vf_dot_visualizer"
        android:layout_width="72dp"
        android:layout_height="56dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="24dp"
        android:layout_marginBottom="24dp"
        android:autoStart="true"
        android:flipInterval="120">

        <ImageView
            android:id="@+id/iv_viz_frame1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:contentDescription="EQ Frame 1" />

        <ImageView
            android:id="@+id/iv_viz_frame2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:contentDescription="EQ Frame 2" />

        <ImageView
            android:id="@+id/iv_viz_frame3"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:contentDescription="EQ Frame 3" />

        <ImageView
            android:id="@+id/iv_viz_frame4"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:contentDescription="EQ Frame 4" />

        <ImageView
            android:id="@+id/iv_viz_frame5"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:contentDescription="EQ Frame 5" />

        <ImageView
            android:id="@+id/iv_viz_frame6"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:contentDescription="EQ Frame 6" />
    </ViewFlipper>

</RelativeLayout>