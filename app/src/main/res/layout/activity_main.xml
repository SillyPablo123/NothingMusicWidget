<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="NOTHING (R)"
        android:textColor="#D71921"
        android:textSize="12sp"
        android:textStyle="bold"
        android:letterSpacing="0.15" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Music Widget"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Widget musical de 3 capas con ecualizador de 4 columnas de puntos y control multimedia en tiempo real."
        android:textColor="#888888"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:background="#1E1E1E"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tv_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ESTADO: Verificando permisos..."
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Para que el widget muestre la canción de Spotify, YouTube Music o tu reproductor y puedas pausar/cambiar canciones desde la pantalla de inicio, se requiere acceso al reproductor del sistema."
            android:textColor="#AAAAAA"
            android:textSize="12sp" />
    </LinearLayout>

    <Button
        android:id="@+id/btn_permission"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="#FFFFFF"
        android:text="Conceder Acceso a Música"
        android:textColor="#121212"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btn_pin_widget"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="12dp"
        android:backgroundTint="#D71921"
        android:text="Añadir Widget a Pantalla de Inicio"
        android:textColor="#FFFFFF"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Una vez añadido, puedes cerrar esta app. El widget funcionará de forma 100% autónoma en tu pantalla de inicio sin abrir pestañas ni navegadores."
        android:textColor="#666666"
        android:textSize="11sp" />

</LinearLayout>