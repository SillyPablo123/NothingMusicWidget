<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container_layer3"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_squircle_dark"
    android:paddingStart="22dp"
    android:paddingTop="22dp"
    android:paddingEnd="22dp"
    android:paddingBottom="18dp">

    <!-- Fila superior: Portada a la izquierda, Ícono del reproductor a la derecha -->
    <RelativeLayout
        android:id="@+id/layout_top_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true">

        <ImageView
            android:id="@+id/iv_details_art"
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:contentDescription="Cover Art"
            android:scaleType="fitXY" />

        <ImageView
            android:id="@+id/iv_player_service"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentTop="true"
            android:contentDescription="Player Service Icon"
            android:scaleType="fitCenter" />
    </RelativeLayout>

    <!-- Sección inferior: Título, Artista y Barra de progreso rectangular -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical">

        <!-- Título de la pista -->
        <TextView
            android:id="@+id/tv_track_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-light"
            android:maxLines="1"
            android:singleLine="true"
            android:text="Título de Canción"
            android:textColor="#BBBBBB"
            android:textSize="22sp"
            android:textStyle="normal" />

        <!-- Nombre del artista (proporcionalmente menor al título) -->
        <TextView
            android:id="@+id/tv_track_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="8dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-light"
            android:maxLines="1"
            android:singleLine="true"
            android:text="Nombre de Artista"
            android:textColor="#BBBBBB"
            android:textSize="20sp"
            android:textStyle="normal" />

        <!-- Barra de progreso 100% rectangular sin borde redondeado -->
        <ProgressBar
            android:id="@+id/pb_timeline"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginBottom="2dp"
            android:max="100"
            android:progress="45"
            android:progressDrawable="@drawable/bg_progress_bar_rect" />
    </LinearLayout>

</RelativeLayout>