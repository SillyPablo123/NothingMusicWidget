<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container_layer3"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_squircle_dark"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/iv_details_art"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="Cover Art"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_track_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-light"
                android:maxLines="1"
                android:text="Título de Canción"
                android:textColor="#BBBBBB"
                android:textSize="19sp"
                android:textStyle="normal" />

            <TextView
                android:id="@+id/tv_track_artist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="7dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-light"
                android:maxLines="1"
                android:text="Nombre de Artista"
                android:textColor="#BBBBBB"
                android:textSize="17sp"
                android:textStyle="normal" />
        </LinearLayout>
    </LinearLayout>

    <!-- Progress Bar (100% Rectangular sin corte redondeado) -->
    <ProgressBar
        android:id="@+id/pb_timeline"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="16dp"
        android:max="100"
        android:progress="45"
        android:progressDrawable="@drawable/bg_progress_bar_rect" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btn_widget_prev"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@android:color/transparent"
            android:contentDescription="Previous Track"
            android:src="@drawable/ic_prev" />

        <ImageButton
            android:id="@+id/btn_widget_play_pause"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:background="@android:color/transparent"
            android:contentDescription="Play Pause"
            android:src="@drawable/ic_play" />

        <ImageButton
            android:id="@+id/btn_widget_next"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@android:color/transparent"
            android:contentDescription="Next Track"
            android:src="@drawable/ic_next" />
    </LinearLayout>

</LinearLayout>